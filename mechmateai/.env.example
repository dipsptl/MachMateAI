# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =============================================================================
# AMAZON DEVELOPER HACKATHON CONFIGURATION (ALL 4 PRIMARY TRACKS)
# When credentials are omitted, MechMate runs in DEVELOPMENT / SIMULATOR mode.
# To connect live production devices or official accounts, provide the keys below:
# =============================================================================

# 1. FIRE TV TRACK
# Fire TV App ID registered in Amazon Developer Console
FIRETV_APP_ID="amzn1.application.firetv.mechmate"
# Optional Fire OS / Vega OS Device Serial number for direct ADB push
FIRETV_DEVICE_SERIAL=""

# 2. ALEXA+ TRACK (MCP & AGENT SKILL)
# Amazon Alexa Skill ID from Alexa Developer Console
ALEXA_SKILL_ID="amzn1.ask.skill.mechmate-industrial-agent"
# Client credentials for Alexa+ Agent Skill API access (optional for local MCP)
ALEXA_CLIENT_ID=""
ALEXA_CLIENT_SECRET=""

# 3. BEE WEARABLE TRACK (BEE DEVICE / APPLE WATCH RUNNING BEE SOFTWARE)
# API key for the Bee Developer API / WebSocket ingestion gateway
BEE_API_KEY=""
# Unique Hardware ID of the Bee wearable device or Apple Watch
BEE_DEVICE_ID=""
# Secret for validating incoming Bee device webhooks
BEE_WEBHOOK_SECRET=""

# 4. RING TRACK (INDUSTRIAL AREA MONITORING & PERIMETER SECURITY)
# OAuth Access Token from Ring Developer Portal / Ring App credentials
RING_API_TOKEN=""
# Ring Location ID corresponding to the plant facility
RING_LOCATION_ID=""
# Webhook secret to verify Ring motion and camera events
RING_WEBHOOK_SECRET=""

# =============================================================================
# AWS BUILDER (Amazon Bedrock) - optional. Copilot uses Bedrock first when enabled,
# then Gemini, then the deterministic engineering engine.
# =============================================================================
BEDROCK_ENABLED="false"
BEDROCK_MODEL_ID="us.amazon.nova-lite-v1:0"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
